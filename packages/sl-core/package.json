{
  "name": "@safelight/sl-core",
  "version": "0.1.0",
  "files": [
    "src"
  ],
  "type": "module",
  "license": "MIT",
  "scripts": {
    "compile": "cd ../../crates/sl-binding && wasm-pack build -t web --out-dir ../../packages/sl-core/src/binding/ --no-pack --no-opt --dev --features debugging",
    "compile:release": "cd ../../crates/sl-binding && wasm-pack build -t web --out-dir ../../packages/sl-core/src/binding/ --no-pack --release",
    "build": "pnpm run compile && tsdown",
    "build:release": "pnpm run compile:release && tsdown"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./daguerreo": {
      "development": "./src/daguerreo.ts",
      "default": "./dist/daguerreo.js"
    },
    "./package.json": "./package.json",
    "./sl_binding.wasm": "./src/binding/sl_binding_bg.wasm"
  },
  "devDependencies": {
    "tsdown": "^0.21.7"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./daguerreo": "./dist/daguerreo.js",
      "./package.json": "./package.json",
      "./sl_binding.wasm": "./dist/sl_binding_bg.wasm"
    }
  },
  "types": "./dist/index.d.ts"
}
